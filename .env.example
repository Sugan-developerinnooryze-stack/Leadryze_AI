# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
# In production, the app refuses to start if this is missing, left as the
# literal default below, or under 16 chars. Must match backend's
# AI_INTERNAL_API_KEY exactly (shared secret, backend -> AI calls).
INTERNAL_API_KEY=internal-service-api-key-change-this-in-production

# ─── LLM Provider (Model Abstraction Layer) ──────────────────────────────────
# Primary provider: openai | anthropic | gemini | groq | local
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# Fallback provider (used if primary fails)
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-2.0-flash-lite

# Maximum tokens per LLM response
MAX_TOKENS_PER_REQUEST=4096

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORG_ID=your-openai-org-id

# ─── Anthropic (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Groq ────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ─── Google Gemini ───────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key

# ─── Embeddings ──────────────────────────────────────────────────────────────
# Provider: voyage | openai
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3

# ─── Voyage AI (embeddings) ──────────────────────────────────────────────────
VOYAGE_API_KEY=your-voyage-api-key

# ─── Qdrant (Vector Store) ───────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=leadryze_knowledge

# ─── Redis (conversation memory + rate limiting) ─────────────────────────────
# Prefer REDIS_URL for a hosted/managed Redis (e.g. Render, Upstash) — when
# set, it takes priority over the individual HOST/PORT/PASSWORD fields below.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_TLS=false

# ─── Guardrails ──────────────────────────────────────────────────────────────
ENABLE_CONTENT_MODERATION=true
ENABLE_PII_FILTER=true
MAX_REQUESTS_PER_TENANT_PER_HOUR=500
MAX_TEMPLATE_ANALYSES_PER_TENANT_PER_DAY=20

# ─── PDF/Image Template Analyzer (Gemini direct API — separate from LLM_PROVIDER above)
TEMPLATE_ANALYZER_MODEL=gemini-flash-latest
TEMPLATE_ANALYZER_MAX_TOKENS=32000
TEMPLATE_ANALYZER_MAX_PDF_PAGES=10

# ─── Demo mode (serves canned responses, no real LLM calls — for sales demos)
DEMO_MODE=false

# ─── Backend (this service calls the backend's /api/internal/* routes) ───────
# Local dev default shown; set to the deployed backend's real URL in production
# (no trailing slash).
BACKEND_URL=http://localhost:5000
# Must match the backend's own INTERNAL_SERVICE_KEY exactly — the shared
# secret both directions of backend<->AI internal calls rely on. Same
# production safety check as INTERNAL_API_KEY above.
INTERNAL_SERVICE_KEY=leadryze-service-key-change-in-prod

# ─── CORS (which frontend origin(s) may call this service directly, if any) ──
CORS_ORIGIN=http://localhost:3000

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
