{
  "name": "leadryze-ai",
  "version": "1.0.0",
  "description": "LeadRyze AI Service — RAG pipeline, LangGraph agents, model abstraction",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "voice-agent": "tsx src/voice-agent/worker.ts dev",
    "voice-agent:start": "node dist/voice-agent/worker.js start",
    "dev:with-voice": "concurrently -k -n SERVER,VOICE-AGENT -c blue,magenta \"npm:dev\" \"npm:voice-agent\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "@google/genai": "^2.12.0",
    "@langchain/anthropic": "^1.5.0",
    "@langchain/core": "^1.2.0",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.4",
    "@langchain/openai": "^1.5.1",
    "@langchain/textsplitters": "^1.0.1",
    "@livekit/agents": "^1.6.2",
    "@livekit/agents-plugin-cartesia": "^1.6.2",
    "@livekit/agents-plugin-deepgram": "^1.6.2",
    "@livekit/agents-plugin-silero": "^1.6.2",
    "@livekit/rtc-node": "^0.13.33",
    "@qdrant/js-client-rest": "^1.10.0",
    "axios": "^1.7.2",
    "cheerio": "^1.2.0",
    "chrono-node": "^2.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "fuse.js": "^7.4.2",
    "groq-sdk": "^1.5.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonrepair": "^3.15.0",
    "langchain": "^1.5.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.53.0",
    "pdf-parse": "^1.1.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "winston": "^3.13.1",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.12",
    "@types/pdf-parse": "^1.1.4",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.5.3"
  }
}
